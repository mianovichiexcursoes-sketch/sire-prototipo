# Copie este arquivo para ".env" (mesma pasta do manage.py) e preencha.
# O ".env" está no .gitignore: nunca envie senhas ao GitHub.
# Sem ".env", o SIRE roda com SQLite, como na entrega original.

# --- PostgreSQL local ---
SIRE_DB_ENGINE=postgresql
SIRE_DB_NAME=sire
SIRE_DB_USER=sire_app
SIRE_DB_PASSWORD=
SIRE_DB_HOST=localhost
SIRE_DB_PORT=5432
# Só no Windows, se aparecer "DLL load failed ... Controle de Aplicativo":
# SIRE_LIBPQ_DIR=C:\Program Files\PostgreSQL\18\bin

# --- Demonstração publicada (definir no painel da hospedagem, não aqui) ---
# SIRE_DEBUG=0
# DJANGO_SECRET_KEY=
# SIRE_ALLOWED_HOSTS=sire.exemplo.com.br
# SIRE_CSRF_TRUSTED_ORIGINS=https://sire.exemplo.com.br
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
